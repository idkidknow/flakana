//| mill-jvm-version: system

package build

import mill.*, scalalib.*

object `package` extends ScalaModule {
  def scalaVersion = "3.9.0"

  def mvnDeps = Seq(
    mvn"org.typelevel::cats-core:2.13.0",
    mvn"org.typelevel::cats-effect:3.7.1",
    mvn"co.fs2::fs2-core:3.14.0",
    mvn"co.fs2::fs2-io:3.14.0",
    mvn"io.circe::circe-core:0.14.17",
    mvn"io.circe::circe-generic:0.14.17",
    mvn"io.circe::circe-parser:0.14.17",
    mvn"io.github.dotty-cps-async::cps-async-connect-cats-effect:1.4.0",
    mvn"com.lihaoyi::os-lib:0.11.8",
    mvn"com.lihaoyi::mainargs:0.7.8",
    mvn"com.lihaoyi::pprint:0.9.6",
    mvn"com.lihaoyi::requests:0.9.3",
  )

  def scriptBundle: T[PathRef] = Task {
    val localPaths = localClasspath().map(_.path).toSet
    val dependencies = runClasspath().map(_.path).filterNot(localPaths)

    os.copy(jar().path, Task.dest / "script.jar")
    os.write(Task.dest / "classpath", dependencies.mkString(java.io.File.pathSeparator))
    os.write(Task.dest / "main-class", finalMainClass())

    PathRef(Task.dest)
  }
}
